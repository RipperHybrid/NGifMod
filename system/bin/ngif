#!/system/bin/weaponx
set -eu

RED="\033[31m"
GREEN="\033[32m"
YELLOW="\033[33m"
CYAN="\033[36m"
RESET="\033[0m"

LOG_DIR="/storage/emulated/0/AshBorn"
mkdir -p "$LOG_DIR"
LOG_FILE="${LOG_DIR}/ngif_$(date +%Y%m%d_%H%M%S).log"
LOG_FAIL=0

declare -a WIDGETS CHANGED_PATHS CHANGED_ASSETS WEBP_FILES SOURCE_FILES
declare -A WIDGET_FILES
declare TYPE_EXT

notify_final() {
    local title="▶ Nothing Widget Animator" msg="$1"
    su 2000 -c "cmd notification post -t '$title' 'nowid' \"$msg\"" >/dev/null 2>&1
}

section() {
    local title="$1" border="◆◆◆◆◆◆◆◆◆◆◆◆◆◆◆◆◆◆◆◆◆◆◆◆◆◆◆◆◆◆◆◆◆◆◆◆◆◆◆◆"
    printf "\n%b%s%b\n" "$CYAN" "$border" "$RESET" | tee -a "$LOG_FILE"
    printf "%b◆  %-38s%b\n" "$CYAN" "$title" "$RESET" | tee -a "$LOG_FILE"
    printf "%b%s%b\n" "$CYAN" "$border" "$RESET" | tee -a "$LOG_FILE"
}

cecho() {
    printf "%b%s%b\n" "$1" "$2" "$RESET" | tee -a "$LOG_FILE"
}

final_cleanup() {
    [[ -n "${TEMP_DIR:-}" && -d "$TEMP_DIR" ]] && rm -rf "$TEMP_DIR" 2>/dev/null
    (( LOG_FAIL == 0 )) && {
        pkill -f com.nothing.hearthstone 2>/dev/null || true
        pkill -f com.nothing.launcher 2>/dev/null || true
    }
    (( LOG_FAIL == 1 )) || rm -f "$LOG_FILE"
}
trap final_cleanup EXIT INT TERM HUP

setup_dir() {
    TEMP_DIR="/data/local/tmp/ngs_$$"
    mkdir -p "$LOG_DIR" "$TEMP_DIR"
    cecho "$GREEN" "▶ ✔ Temporary folder created."
    CHANGED_PATHS=()
    CHANGED_ASSETS=()
}

track_folder() {
    local path="$1"
    [[ -d "$path" ]] && [[ ! " ${CHANGED_PATHS[*]} " =~ " ${path} " ]] && CHANGED_PATHS+=("$path")
}

track_asset() {
    local filename="$(basename "$1")"
    [[ ! " ${CHANGED_ASSETS[*]} " =~ " ${filename} " ]] && CHANGED_ASSETS+=("$filename")
}

fix_permissions() {
    section "Setting Permissions"
    for path in "${CHANGED_PATHS[@]}"; do
        [[ -d "$path" ]] && chmod -R 777 "$path" 2>/dev/null || true
    done
    if (( ${#CHANGED_ASSETS[@]} > 0 )); then
        printf "%b▶ Modified assets:%b\n" "$CYAN" "$RESET" | tee -a "$LOG_FILE"
        for asset in "${CHANGED_ASSETS[@]}"; do
            local short_name="${asset:0:35}..."
            cecho "$GREEN" "  ✔ $short_name"
        done
    else
        cecho "$YELLOW" "▶ No assets to set permissions for"
    fi
}

check_env() {
    (( $(id -u) != 0 )) && {
        cecho "$RED" "▶ ✖ [Error: Run as root]"
        cecho "$YELLOW" "▶ ⚠ [Exit the terminal completely and restart after enabling root]"
        LOG_FAIL=1
        exit 1
    }
    local -a required_tools=(ffmpeg ffprobe)
    local -a missing_tools=()
    for tool in "${required_tools[@]}"; do
        command -v "$tool" >/dev/null 2>&1 || missing_tools+=("$tool")
    done
    (( ${#missing_tools[@]} > 0 )) && {
        cecho "$RED" "▶ ✖ [Missing required tools: ${missing_tools[*]}]"
        LOG_FAIL=1
        exit 1
    }
    pm list packages | grep -q "com.nothing.hearthstone" || {
        cecho "$RED" "▶ ✖ [App not installed: com.nothing.hearthstone]"
        LOG_FAIL=1
        exit 1
    }
    [[ ! -d "/data/user/0/com.nothing.hearthstone" ]] && {
        cecho "$RED" "▶ ✖ [Cannot access app data folder]"
        cecho "$YELLOW" "▶ ⚠ [Enable 'Global Namespace' or Mount Namespace Mode in your root solution]"
        LOG_FAIL=1
        exit 1
    }
    cecho "$GREEN" "  ▶ ✔ Environment OK"
}

discover_widgets() {
    local widget_dir="/data/user/0/com.nothing.hearthstone/files/picture/normal"
    [[ ! -d "$widget_dir" ]] && {
        cecho "$RED" "▶ ✖ [Widget directory missing]"
        LOG_FAIL=1
        return 1
    }

    WIDGETS=()
    WIDGET_FILES=()

    local dir
    for dir in "$widget_dir"/*/; do
        [[ -d "$dir" ]] || continue
        local name=$(basename "$dir")
        [[ "$name" == "*" ]] && continue
        [[ "$name" =~ [x×] ]] && continue
        
        local count=0
        count=$(find "$dir" -name "nothing_photo_*.webp" -type f 2>/dev/null | wc -l)
        (( count > 0 )) && {
            WIDGETS+=("$name")
            WIDGET_FILES["$name"]=$count
        }
    done

    (( ${#WIDGETS[@]} == 0 )) && {
        cecho "$RED" "▶ ✖ [No widgets found with WebP files]"
        LOG_FAIL=1
        return 1
    }
    return 0
}

display_widgets() {
    section "Available Widgets"
    local i=1
    for widget in "${WIDGETS[@]}"; do
        printf "  %b%d) %s %b(%d files)%b\n" "$GREEN" "$i" "$widget" "$YELLOW" "${WIDGET_FILES[$widget]}" "$RESET" | tee -a "$LOG_FILE"
        ((i++))
    done
}

pick_widget() {
    discover_widgets || return 1

    local widget_name
    if (( ${#WIDGETS[@]} == 1 )); then
        widget_name="${WIDGETS[0]}"
        cecho "$YELLOW" "▶ Only one widget found: $widget_name. Selecting automatically."
    else
        display_widgets
        local choice
        while true; do
            printf "%b▶ Select widget (number): %b" "$CYAN" "$RESET" | tee -a "$LOG_FILE"
            read -r choice
            [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#WIDGETS[@]} )) && {
                widget_name="${WIDGETS[$((choice-1))]}"
                break
            }
            cecho "$RED" "▶ ✖ Invalid choice"
        done
    fi

    TARGET_PATH="/data/user/0/com.nothing.hearthstone/files/picture/normal/${widget_name}/"
    MONO_PATH="/data/user/0/com.nothing.hearthstone/files/picture/mono/${widget_name}/"

    [[ ! -d "$TARGET_PATH" ]] && {
        cecho "$RED" "▶ ✖ [Target directory missing: $TARGET_PATH]"
        LOG_FAIL=1
        return 1
    }

    [[ ! -d "$MONO_PATH" ]] && mkdir -p "$MONO_PATH"

    cecho "$GREEN" "▶ ✔ Widget selection completed"
    return 0
}

scan_assets() {
    WEBP_FILES=()
    while IFS= read -r -d '' file; do
        WEBP_FILES+=("$file")
    done < <(find "$TARGET_PATH" -name "nothing_photo_*.webp" -type f -print0 2>/dev/null)

    if (( ${#WEBP_FILES[@]} > 0 )); then
        cecho "$CYAN" "▶ WebP files found:"
        for file in "${WEBP_FILES[@]}"; do
            cecho "$CYAN" "  - $(basename "$file")"
        done
    else
        cecho "$RED" "▶ ✖ [No WebP files found in $TARGET_PATH]"
        LOG_FAIL=1
        return 1
    fi
    return 0
}

choose_mode() {
    local mode=1
    if (( ${#WEBP_FILES[@]} > 1 )); then
        section "Replacement Mode"
        printf "  %b1) Replace single\n  %b2) Replace multiple%b\n" "$CYAN" "$CYAN" "$RESET" | tee -a "$LOG_FILE"
        printf "\n%b▶ Select mode: %b" "$CYAN" "$RESET" | tee -a "$LOG_FILE"
        while true; do
            read -r mode
            case "$mode" in
                1|2) break ;;
                *) cecho "$RED" "▶ ✖ Invalid mode"; printf "%b▶ Select mode: %b" "$CYAN" "$RESET" | tee -a "$LOG_FILE";;
            esac
        done
    fi
    MODE="$mode"
}

validate_media_file() {
    local file="$1"
    [[ ! -f "$file" || ! -r "$file" ]] && {
        cecho "$RED" "▶ ✖ [File not accessible: $(basename "$file")]"
        return 1
    }
    local size
    size=$(stat -c %s "$file" 2>/dev/null)
    (( size > 104857600 )) && {
        cecho "$RED" "▶ ✖ [File too large: $(basename "$file") (>100MB)]"
        return 1
    }
    ffprobe -v quiet -i "$file" 2>/dev/null || {
        cecho "$RED" "▶ ✖ [Invalid media file: $(basename "$file")]"
        return 1
    }
    local has_video
    has_video=$(ffprobe -v error -select_streams v:0 -show_entries stream=codec_type -of default=noprint_wrappers=1:nokey=1 "$file" 2>/dev/null | wc -l)
    (( has_video == 0 )) && {
        cecho "$RED" "▶ ✖ [No video stream in: $(basename "$file")]"
        return 1
    }
    return 0
}

get_media_info() {
    local file="$1"
    local format_name duration width height fps
    format_name=$(ffprobe -v error -show_entries format=format_name -of default=noprint_wrappers=1:nokey=1 "$file" 2>/dev/null | head -1)
    format_name="${format_name:-${file##*.}}"
    duration=$(ffprobe -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 "$file" 2>/dev/null | head -1)
    local duration_display="unknown"
    if [[ -n "$duration" && "$duration" != "N/A" ]]; then
        local duration_int
        duration_int=$(printf "%.0f" "$duration" 2>/dev/null)
        if (( duration_int > 0 )); then
            local fmt
            if (( duration_int >= 3600 )); then
                fmt="%H:%M:%S"
            else
                fmt="%M:%S"
            fi
            duration_display=$(date -u -d "@$duration_int" +"$fmt" 2>/dev/null || echo "${duration}s")
        else
            duration_display="${duration}s"
        fi
    fi
    width=$(ffprobe -v error -select_streams v:0 -show_entries stream=width -of default=noprint_wrappers=1:nokey=1 "$file" 2>/dev/null | head -1)
    height=$(ffprobe -v error -select_streams v:0 -show_entries stream=height -of default=noprint_wrappers=1:nokey=1 "$file" 2>/dev/null | head -1)
    local size_display="unknown"
    [[ -n "$width" && -n "$height" ]] && size_display="${width}x${height}"
    fps=$(ffprobe -v error -select_streams v:0 -show_entries stream=r_frame_rate -of default=noprint_wrappers=1:nokey=1 "$file" 2>/dev/null | head -1)
    local fps_display="unknown"
    if [[ -n "$fps" && "$fps" == */* ]]; then
        IFS='/' read -r num den <<< "$fps"
        (( den != 0 )) && fps_display=$(awk "BEGIN {printf \"%.2f\", $num / $den}")
    elif [[ -n "$fps" ]]; then
        fps_display="$fps"
    fi
    echo "Format: ${format_name} | Duration: $duration_display | Size: $size_display | FPS: $fps_display"
}

create_webp() {
    local src="$1"
    local out="$TEMP_DIR/$(basename "${src%.*}")_$(date +%s%N).webp"
    local fps
    fps=$(ffprobe -v error -select_streams v:0 -show_entries stream=r_frame_rate -of default=noprint_wrappers=1:nokey=1 "$src" 2>/dev/null)
    if [[ -n "$fps" && "$fps" == */* ]]; then
        IFS='/' read -r num den <<< "$fps"
        (( den != 0 )) && fps=$(awk "BEGIN {printf \"%.2f\", $num / $den}") || fps="24"
    fi
    fps="${fps:-24}"
    ffmpeg -y -i "$src" -an -vf "fps=$fps,scale=320:-1:flags=lanczos,split[s0][s1];[s0]palettegen[p];[s1][p]paletteuse" -loop 0 "$out" 2>> "$LOG_FILE" || {
        cecho "$RED" "▶ ✖ [Conversion failed for: $(basename "$src")]"
        LOG_FAIL=1
        return 1
    }
    [[ -f "$out" && -s "$out" ]] && echo "$out"
}

create_grayscale() {
    local src="$1" dest="$2"
    local fps
    fps=$(ffprobe -v error -select_streams v:0 -show_entries stream=r_frame_rate -of default=noprint_wrappers=1:nokey=1 "$src" 2>/dev/null)
    if [[ -n "$fps" && "$fps" == */* ]]; then
        IFS='/' read -r num den <<< "$fps"
        (( den != 0 )) && fps=$(awk "BEGIN {printf \"%.2f\", $num / $den}") || fps="24"
    fi
    fps="${fps:-24}"
    local has_alpha
    has_alpha=$(ffprobe -v error -select_streams v:0 -show_entries stream=pix_fmt -of default=noprint_wrappers=1:nokey=1 "$src" 2>/dev/null | grep -cE "rgba|yuva")
    if (( has_alpha > 0 )); then
        ffmpeg -y -i "$src" -an -filter_complex "[0:v]format=rgba,fps=$fps,scale=320:-1:flags=lanczos,hue=s=0,split[s0][s1];[s0]palettegen=reserve_transparent=1:stats_mode=diff[p];[s1][p]paletteuse=alpha_threshold=128" -loop 0 "$dest" 2>> "$LOG_FILE"
    else
        ffmpeg -y -i "$src" -an -vf "fps=$fps,scale=320:-1:flags=lanczos,hue=s=0" -loop 0 "$dest" 2>> "$LOG_FILE"
    fi
    [[ -s "$dest" ]] || {
        cecho "$RED" "▶ ✖ [Mono conversion failed for: $(basename "$src")]"
        LOG_FAIL=1
        return 1
    }
}

pick_source_type() {
    section "Source Type"
    printf "  %b1) GIF\n  %b2) MP4\n  %b3) MKV\n  %b4) Other Video (WebM/AVI/MOV/MPEG)%b\n" "$CYAN" "$CYAN" "$CYAN" "$CYAN" "$RESET" | tee -a "$LOG_FILE"
    printf "\n%b▶ Select source type: %b" "$CYAN" "$RESET" | tee -a "$LOG_FILE"
    while true; do
        read -r type
        case "$type" in
            1) TYPE_EXT="gif"; break ;;
            2) TYPE_EXT="mp4"; break ;;
            3) TYPE_EXT="mkv"; break ;;
            4) TYPE_EXT="any"; break ;;
            *) cecho "$RED" "▶ ✖ Invalid type"; printf "%b▶ Select source type: %b" "$CYAN" "$RESET" | tee -a "$LOG_FILE";;
        esac
    done
}

find_media_files() {
    local keyword="$1" type_ext="$2"
    SOURCE_FILES=()
    local -a patterns
    
    case "$type_ext" in
        gif) patterns=("*.gif") ;;
        mp4) patterns=("*.mp4") ;;
        mkv) patterns=("*.mkv") ;;
        any) patterns=("*.gif" "*.mp4" "*.mkv" "*.webm" "*.avi" "*.mov" "*.mpeg" "*.mpg") ;;
        *) patterns=() ;;
    esac

    for pattern in "${patterns[@]}"; do
        while IFS= read -r -d '' file; do
            if [[ -n "$keyword" ]]; then
                [[ "$(basename "$file")" == *"$keyword"* ]] && SOURCE_FILES+=("$file")
            else
                SOURCE_FILES+=("$file")
            fi
        done < <(find /storage/emulated/0 -type f -iname "$pattern" -size -100M ! -path "*/Android/*" ! -name ".*" -print0 2>/dev/null)
    done
}

search_all_formats() {
    local keyword="$1"
    local -a patterns=("*.gif" "*.mp4" "*.mkv" "*.webm" "*.avi" "*.mov" "*.mpeg" "*.mpg")
    
    for pattern in "${patterns[@]}"; do
        while IFS= read -r -d '' file; do
            if [[ -n "$keyword" ]]; then
                [[ "$(basename "$file")" == *"$keyword"* ]] && SOURCE_FILES+=("$file")
            else
                SOURCE_FILES+=("$file")
            fi
        done < <(find /storage/emulated/0 -type f -iname "$pattern" -size -100M ! -path "*/Android/*" ! -name ".*" -print0 2>/dev/null)
    done
}

process_selection() {
    if [ "$MODE" = 1 ]; then
        local selected_webp
        if (( ${#WEBP_FILES[@]} == 1 )); then
            selected_webp="${WEBP_FILES[0]}"
        else
            section "Select WebP to Replace"
            for i in "${!WEBP_FILES[@]}"; do
                printf "  %b%d) %s%b\n" "$GREEN" "$((i+1))" "$(basename "${WEBP_FILES[i]}")" "$RESET"
            done
            printf "\n%b▶ Choose: %b" "$CYAN" "$RESET"
            while true; do
                read -r choice
                [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#WEBP_FILES[@]} )) && {
                    selected_webp="${WEBP_FILES[$((choice-1))]}"
                    break
                }
                cecho "$RED" "▶ ✖ Invalid choice"
                printf "%b▶ Choose: %b" "$CYAN" "$RESET"
            done
        fi

        pick_source_type

        section "Select Source Directory"
        printf "  %b1) Scan /storage/emulated/0/\n  %b2) Search by keyword in filename%b\n" "$CYAN" "$CYAN" "$RESET"
        local src_choice
        while true; do
            printf "%b▶ Select source: %b" "$CYAN" "$RESET"
            read -r src_choice
            case "$src_choice" in
                1)
                    find_media_files "" "$TYPE_EXT"
                    if (( ${#SOURCE_FILES[@]} == 0 )); then
                        cecho "$YELLOW" "▶ No $TYPE_EXT files found. Searching all formats..."
                        search_all_formats ""
                        TYPE_EXT="any"
                    fi
                    if (( ${#SOURCE_FILES[@]} > 30 )); then
                        cecho "$YELLOW" "▶ There are more than 30 files (${#SOURCE_FILES[@]} found). Use keyword search?"
                        printf "%b▶ Use keyword search instead? (y/n): %b" "$CYAN" "$RESET"
                        read -r ans
                        case "$ans" in
                            y|Y) continue ;;
                            n|N) break ;;
                            *) cecho "$RED" "✖ Invalid choice"; continue ;;
                        esac
                    elif (( ${#SOURCE_FILES[@]} == 0 )); then
                        cecho "$RED" "✖ [No valid source files found (max 100MB each)]"
                        return 1
                    else
                        break
                    fi
                    ;;
                2)
                    printf "%b▶ Enter part of filename to search: %b" "$CYAN" "$RESET"
                    read -r keyword
                    if [ -z "$keyword" ]; then
                        cecho "$RED" "✖ No keyword entered"
                        continue
                    fi
                    find_media_files "$keyword" "$TYPE_EXT"
                    if (( ${#SOURCE_FILES[@]} == 0 )); then
                        cecho "$YELLOW" "▶ No $TYPE_EXT files found with keyword '$keyword'. Searching all formats..."
                        search_all_formats "$keyword"
                        TYPE_EXT="any"
                    fi
                    if (( ${#SOURCE_FILES[@]} == 0 )); then
                        cecho "$RED" "✖ [No valid source files found (max 100MB each)]"
                        return 1
                    fi
                    break
                    ;;
                *) cecho "$RED" "✖ Invalid choice" ;;
            esac
        done

        local selected_source
        if (( ${#SOURCE_FILES[@]} == 1 )); then
            selected_source="${SOURCE_FILES[0]}"
            cecho "$YELLOW" "▶ 1 file found: $(basename "$selected_source")"
            while true; do
                printf "%b▶ Use this file? (y/n or -skip): %b" "$CYAN" "$RESET"
                read -r confirm
                case "$confirm" in
                    y|Y)
                        break
                        ;;
                    n|N|"-skip")
                        cecho "$YELLOW" "▶ Skipped. Please try another keyword or source type."
                        return 1
                        ;;
                    *)
                        cecho "$RED" "▶ ✖ Invalid choice. Please enter y, n, or -skip."
                        ;;
                esac
            done
            printf "%b▶ File selected: %s%b\n" "$YELLOW" "$(basename "$selected_source")" "$RESET"
        else
            printf "%b▶ Available source files:%b\n" "$CYAN" "$RESET"
            for i in "${!SOURCE_FILES[@]}"; do
                printf "  %b%d) %s%b\n" "$GREEN" "$((i+1))" "$(basename "${SOURCE_FILES[i]}")" "$RESET"
            done
            printf "\n%b▶ Select file (number): %b" "$CYAN" "$RESET"
            while true; do
                read -r file_choice
                [[ "$file_choice" =~ ^[0-9]+$ ]] && (( file_choice >= 1 && file_choice <= ${#SOURCE_FILES[@]} )) && {
                    selected_source="${SOURCE_FILES[$((file_choice-1))]}"
                    break
                }
                cecho "$RED" "▶ ✖ Invalid choice"
                printf "%b▶ Select file: %b" "$CYAN" "$RESET"
            done
            cecho "$YELLOW" "▶ File selected: $(basename "$selected_source")"
        fi

        if validate_media_file "$selected_source"; then
            media_info=$(get_media_info "$selected_source")
            cecho "$CYAN" "▶ Media info: $media_info"
            cecho "$CYAN" "▶ Converting and applying for widget (This may take a while)..."
            webp_tmp=$(create_webp "$selected_source") || return 1
            cecho "$YELLOW" "▶ Creating grayscale for $(basename "$selected_source")"
            gray_tmp="${MONO_PATH}$(basename "$selected_webp")"
            create_grayscale "$selected_source" "$gray_tmp"
            cp "$webp_tmp" "$selected_webp" || {
                cecho "$RED" "▶ ✖ Failed to update normal widget"
                return 1
            }
            track_folder "$TARGET_PATH"
            track_folder "$MONO_PATH"
            track_asset "$selected_webp"
            cecho "$GREEN" "✔ Normal widget updated successfully"
        else
            cecho "$RED" "▶ Skipping invalid file"
            return 1
        fi
    else
        section "Select WebPs to Replace"
        printf "  %b0) Select all%b\n" "$GREEN" "$RESET"
        for i in "${!WEBP_FILES[@]}"; do
            printf "  %b%d) %s%b\n" "$GREEN" "$((i+1))" "$(basename "${WEBP_FILES[$i]}")" "$RESET"
        done
        printf "%b▶ Enter widget numbers to replace (comma-separated): %b" "$CYAN" "$RESET"
        read -r selected_nums
        selected_nums="${selected_nums// /}"
        local selected_indices=()
        if [[ "$selected_nums" == "0" ]]; then
            for i in "${!WEBP_FILES[@]}"; do selected_indices+=("$i"); done
        else
            IFS=',' read -ra nums <<< "$selected_nums"
            for num in "${nums[@]}"; do
                if [[ "$num" =~ ^[0-9]+$ ]] && (( num >= 1 && num <= ${#WEBP_FILES[@]} )); then
                    selected_indices+=("$((num-1))")
                else
                    cecho "$YELLOW" "▶ Ignoring invalid index: $num"
                fi
            done
        fi
        (( ${#selected_indices[@]} == 0 )) && { cecho "$RED" "▶ ✖ No valid WebPs selected."; return 1; }

        pick_source_type

        section "Select Source Directory"
        printf "  %b1) Scan /storage/emulated/0/\n  %b2) Keyword for each widget (advanced)%b\n" "$CYAN" "$CYAN" "$RESET"
        local chosen_sources=()
        while true; do
            printf "%b▶ Select source: %b" "$CYAN" "$RESET"
            read -r src
            case "$src" in
                1)
                    find_media_files "" "$TYPE_EXT"
                    if (( ${#SOURCE_FILES[@]} == 0 )); then
                        cecho "$YELLOW" "▶ No $TYPE_EXT files found. Searching all formats..."
                        search_all_formats ""
                        TYPE_EXT="any"
                    fi
                    if (( ${#SOURCE_FILES[@]} == 0 )); then
                        cecho "$RED" "✖ [No valid source files found (max 100MB each)]"
                        continue
                    fi
                    printf "%b▶ Available source files:%b\n" "$CYAN" "$RESET"
                    for i in "${!SOURCE_FILES[@]}"; do
                        printf "  %b%d) %s%b\n" "$GREEN" "$((i+1))" "$(basename "${SOURCE_FILES[i]}")" "$RESET"
                    done
                    local widget_count=${#selected_indices[@]}
                    printf "%b▶ Enter file numbers to use for widgets (%d) in order (comma-separated): %b" "$CYAN" "$widget_count" "$RESET"
                    read -r selected_files
                    selected_files="${selected_files// /}"
                    IFS=',' read -ra file_nums <<< "$selected_files"
                    if (( ${#file_nums[@]} != widget_count )); then
                        cecho "$RED" "▶ ✖ Please select exactly $widget_count file numbers"
                        continue
                    fi
                    for idx in "${!selected_indices[@]}"; do
                        file_idx="${file_nums[$idx]}"
                        if [[ "$file_idx" =~ ^[0-9]+$ ]] && (( file_idx >= 1 && file_idx <= ${#SOURCE_FILES[@]} )); then
                            chosen_sources[$idx]="${SOURCE_FILES[$((file_idx-1))]}"
                        else
                            chosen_sources[$idx]=""
                        fi
                    done
                    break
                    ;;
                2)
                    for idx in "${!selected_indices[@]}"; do
                        local webp="${WEBP_FILES[${selected_indices[$idx]}]}"
                        while true; do
                            printf "%b▶ Enter part of filename for widget %s (or -skip): %b" "$CYAN" "$(basename "$webp")" "$RESET"
                            read -r keyword
                            keyword="$(echo "$keyword" | tr -d '\r' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
                            if [[ "$keyword" == "-skip" ]]; then
                                chosen_sources[$idx]=""
                                cecho "$YELLOW" "▶ Skipping widget: $(basename "$webp")"
                                break
                            elif [[ -z "$keyword" ]]; then
                                cecho "$RED" "▶ ✖ No keyword entered"
                                continue
                            fi
                            find_media_files "$keyword" "$TYPE_EXT"
                            if (( ${#SOURCE_FILES[@]} == 0 )); then
                                cecho "$YELLOW" "▶ No $TYPE_EXT files found with keyword '$keyword'. Searching all formats..."
                                search_all_formats "$keyword"
                                TYPE_EXT="any"
                            fi
                            if (( ${#SOURCE_FILES[@]} == 0 )); then
                                cecho "$RED" "▶ ✖ No files found for keyword '$keyword'."
                                continue
                            elif (( ${#SOURCE_FILES[@]} == 1 )); then
                                local single_file="${SOURCE_FILES[0]}"
                                printf "%b▶ 1 file found for widget %s: %s%b\n" "$YELLOW" "$(basename "$webp")" "$(basename "$single_file")" "$RESET"
                                while true; do
                                    printf "%b▶ Use this file for widget %s? (y/n or -skip): %b" "$CYAN" "$(basename "$webp")" "$RESET"
                                    read -r confirm
                                    case "$confirm" in
                                        y|Y)
                                            chosen_sources[$idx]="$single_file"
                                            printf "%b▶ File selected: %s%b\n" "$YELLOW" "$(basename "$single_file")" "$RESET"
                                            break
                                            ;;
                                        n|N)
                                            break
                                            ;;
                                        -skip)
                                            chosen_sources[$idx]=""
                                            cecho "$YELLOW" "▶ Skipping widget: $(basename "$webp")"
                                            break 2
                                            ;;
                                        *)
                                            cecho "$RED" "▶ ✖ Invalid choice. Please enter y, n, or -skip."
                                            ;;
                                    esac
                                done
                                [[ "${confirm,,}" != "n" ]] && break
                            else
                                for i in "${!SOURCE_FILES[@]}"; do
                                    printf "  %b%d) %s%b\n" "$GREEN" "$((i+1))" "$(basename "${SOURCE_FILES[i]}")" "$RESET"
                                done
                                printf "%b▶ Select file (number) or -skip: %b" "$CYAN" "$RESET"
                                read -r fchoice
                                if [[ "$fchoice" == "-skip" ]]; then
                                    chosen_sources[$idx]=""
                                    cecho "$YELLOW" "▶ Skipping widget: $(basename "$webp")"
                                    break
                                elif [[ "$fchoice" =~ ^[0-9]+$ ]] && (( fchoice >= 1 && fchoice <= ${#SOURCE_FILES[@]} )); then
                                    chosen_sources[$idx]="${SOURCE_FILES[$((fchoice-1))]}"
                                    printf "%b▶ File selected: %s%b\n" "$YELLOW" "$(basename "${SOURCE_FILES[$((fchoice-1))]}")" "$RESET"
                                    break
                                else
                                    cecho "$RED" "▶ ✖ Invalid selection"
                                fi
                            fi
                        done
                    done
                    break
                    ;;
                *) cecho "$RED" "✖ Invalid choice" ;;
            esac
        done

        for i in "${!selected_indices[@]}"; do
            src="${chosen_sources[$i]}"
            [[ -z "$src" ]] && continue
            webp="${WEBP_FILES[${selected_indices[$i]}]}"
            mono="$MONO_PATH$(basename "$webp")"
            if validate_media_file "$src"; then
                media_info=$(get_media_info "$src")
                cecho "$CYAN" "▶ Media info: $media_info"
                cecho "$CYAN" "▶ Converting and applying for widget (This may take a while)..."
                webp_tmp=$(create_webp "$src") || { cecho "$RED" "▶ ✖ Conversion failed for %s" "$(basename "$src")"; continue; }
                cecho "$YELLOW" "▶ Creating grayscale for $(basename "$src")"
                create_grayscale "$src" "$mono"
                cp "$webp_tmp" "$webp"
                track_folder "$TARGET_PATH"
                track_folder "$MONO_PATH"
                track_asset "$webp"
                cecho "$GREEN" "▶ ✔ Updated: $(basename "$webp")"
            else
                cecho "$RED" "▶ Skipping invalid file: $(basename "$src")"
            fi
        done
    fi
}

main_menu() {
    section "Nothing Widget Animator By AshBorn"
    printf "  %b▶ Backup will be back with better optimisation%b\n" "$YELLOW" "$RESET" | tee -a "$LOG_FILE"
    printf "  %b▶ Restore function will be added later%b\n" "$YELLOW" "$RESET" | tee -a "$LOG_FILE"
    check_env
    printf "  %b1) Animate Widgets\n  %b2) Exit%b\n" "$CYAN" "$CYAN" "$RESET" | tee -a "$LOG_FILE"
    printf "\n%b▶ Select an option: %b" "$CYAN" "$RESET" | tee -a "$LOG_FILE"
    while true; do
        read -r menu_choice
        case "$menu_choice" in
            1)
                setup_dir
                pick_widget || { cecho "$RED" "▶ ✖ Widget selection failed"; continue; }
                scan_assets || { cecho "$RED" "▶ ✖ Asset scan failed"; continue; }
                choose_mode
                process_selection || { cecho "$RED" "▶ ✖ Processing failed"; continue; }
                fix_permissions
                rm -rf /data/user/0/com.nothing.launcher/cache/image_manager_disk_cache 2>/dev/null || true
                section "Done"
                cecho "$GREEN" "▶ ✔ Script finished. All changes applied."
                local replaced_count=${#CHANGED_ASSETS[@]}
                if (( LOG_FAIL == 1 )); then
                    notify_final "❌ Script finished with errors. Log: AshBorn/$(basename "$LOG_FILE")"
                else
                    notify_final "✔ All changes applied. Modified assets: $replaced_count"
                fi
                break
                ;;
            2)
                cecho "$GREEN" "▶ Exiting..."
                exit 0
                ;;
            *)
                cecho "$RED" "▶ ✖ Invalid option"
                printf "%b▶ Select an option: %b" "$CYAN" "$RESET" | tee -a "$LOG_FILE"
                ;;
        esac
    done
}

main_menu